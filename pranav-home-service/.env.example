# ---------------------------------------------------------------------------
# Pranav Home Service - environment variables (PLACEHOLDERS ONLY)
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Public site settings (safe to expose to the browser) ------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase WEB config (PUBLIC identifiers, NOT secrets) -----------------
# Found in Firebase console > Project settings > Your apps > Web app.
# They identify your project; security comes from Firestore rules, not secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Firebase ADMIN credentials (PRIVATE, server-only) ---------------------
# From Firebase console > Project settings > Service accounts > Generate new private key.
# Copy the three values from the downloaded JSON. NEVER prefix with NEXT_PUBLIC_.
# Keep the \n escapes in the private key; the app converts them back to newlines.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# --- Abuse protection -------------------------------------------------------
# Long random string (>= 32 chars). Used as an HMAC key so IP addresses and duplicate
# fingerprints are stored only as keyed hashes. Generate with: openssl rand -base64 32
HASH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Local development with the Firebase emulator (optional) ----------------
# When set, the Admin SDK talks to the local emulator and no service-account key is needed.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
