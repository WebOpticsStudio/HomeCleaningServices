rules_version = '2';

// Least-privilege rules for Pranav Home Service.
//
// The public website NEVER reads or writes Firestore from the browser. Every booking is
// validated and stored by a Next.js Server Action using the Firebase Admin SDK, which
// bypasses these rules. Therefore anonymous and signed-in end users get NO access at all.
//
// The only exception is an OPTIONAL admin area (not included in this starter). Admins are
// identified by a custom claim `admin: true` that you set from a trusted environment:
//   getAuth().setCustomUserClaims(uid, { admin: true })
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Booking records contain personal information (name, phone, address).
    match /bookings/{bookingId} {
      allow create, delete: if false;                 // created only by the server
      allow read: if isAdmin();                       // never public
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled'];
    }

    // Idempotency / duplicate markers are internal to the server.
    match /bookingDedupe/{key} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
